# --- Telegram user account (читає канал) ---
# Отримати на https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# Канал зі сповіщеннями: @username, посилання t.me/... або числовий id
# (числовий id можна знайти командою: python -m power_notifier list-chats)
TG_CHANNEL=
# Файл сесії Telethon (НЕ комітити)
TG_SESSION=data/user

# --- Канал сповіщення №1: Bark (iOS, рекомендовано) ---
# Ключ з застосунку Bark на iPhone (https://apps.apple.com/app/id1403753865)
BARK_KEY=
BARK_SERVER=https://api.day.app
# Звук: alarm, bell, birdsong, glass, horn, ladder, minuet, multiwayinvitation ...
BARK_SOUND=alarm
# critical = звучить навіть у беззвучному режимі / Focus
BARK_CRITICAL=true
BARK_VOLUME=10
# Повторювати звук ~30 секунд
BARK_CALL=false

# --- Канал сповіщення №2: Telegram-бот (опціонально) ---
# Токен від @BotFather. Напишіть боту /start і поставте на чат з ним окремий звук.
TG_BOT_TOKEN=
# Якщо порожньо — береться id вашого акаунта автоматично
TG_BOT_CHAT_ID=

# --- Поведінка ---
# Ігнорувати повідомлення, старші за N хвилин (захист від старих подій після перезапуску)
MAX_MESSAGE_AGE_MIN=30
# Також надсилати (тихе) сповіщення, коли світло зникло
NOTIFY_ON_OFF=false
LOG_LEVEL=INFO
