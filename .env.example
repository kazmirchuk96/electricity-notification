# Локальний .env потрібен лише для ручних перевірок (test-notify, poll) і режиму `run` на VPS.
# У GitHub Actions ті самі значення задаються як Secrets / Variables репозиторію (див. README).

# Публічний канал СвітлоБота: @username або посилання t.me/username
# (для режиму `run` також підходить числовий id з `list-chats`)
TG_CHANNEL=

# --- Канал сповіщення №1: Bark (iOS, рекомендовано) ---
# Ключ з застосунку Bark на iPhone (https://apps.apple.com/app/id1403753865)
BARK_KEY=
BARK_SERVER=https://api.day.app
# Звук: alarm, bell, birdsong, glass, horn, ladder, minuet, multiwayinvitation ...
BARK_SOUND=alarm
# critical = звучить навіть у беззвучному режимі / Focus
BARK_CRITICAL=true
BARK_VOLUME=10
# Повторювати звук ~30 секунд
BARK_CALL=false
# Скільки разів надіслати сповіщення «світло з'явилося» (кожне — окремий звук, пауза ~4 с)
BARK_REPEAT=1
# URL картинки, яка показується замість іконки Bark (iOS 15+), напр. лампочка Twemoji (CC-BY 4.0):
# https://cdn.jsdelivr.net/gh/jdecked/twemoji@15.1.0/assets/72x72/1f4a1.png
BARK_ICON=

# --- Канал сповіщення №2: Telegram-бот (опціонально) ---
# Токен від @BotFather. Напишіть боту /start і поставте на чат з ним окремий звук.
TG_BOT_TOKEN=
# Ваш числовий id у Telegram (можна дізнатись у @userinfobot)
TG_BOT_CHAT_ID=

# --- Поведінка ---
# Ігнорувати події, старші за N хвилин (0 = не ігнорувати). У GitHub Actions за замовч. 120.
MAX_MESSAGE_AGE_MIN=30
# Також надсилати (тихе) сповіщення, коли світло зникло
NOTIFY_ON_OFF=false
# Тихі години: у цей проміжок сповіщення не надсилаються (порожньо = вимкнено)
QUIET_HOURS=
TIMEZONE=Europe/Kyiv
# Файл стану для `poll` (id останнього обробленого поста)
STATE_FILE=data/state.json
LOG_LEVEL=INFO

# --- Лише для режиму `run` (VPS, читання через ваш Telegram-акаунт) ---
# https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
TG_SESSION=data/user
